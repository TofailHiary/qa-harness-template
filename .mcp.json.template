{
  "//": "TEMPLATE. Do not copy by hand: run python .claude/scripts/render_mcp.py (the /configure-project bootstrap does). It writes .mcp.json from this file and PROJECT-PROFILE.md: ${PROJECT_ROOT} becomes this project's path, servers whose capability is off in §2 get disabled:true, and on Windows every npx server is wrapped in 'cmd /c'. Secrets stay as ${ENV_VAR} placeholders that Claude Code expands at runtime; render_mcp.py prints the export lines to set. NEVER commit a filled .mcp.json (see .gitignore). Versions are pinned: '_tested' says whether the version was exercised with this template. Bump them deliberately (docs/upgrading.md). GitHub and Atlassian/Jira are Claude Code connectors configured outside this file. A project-specific MCP server (PROJECT-PROFILE.md §14) and other DB engines (Postgres, Mongo, ...) are added by /configure-project with your approval.",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.0.1", "${PROJECT_ROOT}/qa-evidence", "${PROJECT_ROOT}/.claude"],
      "disabled": false,
      "_capability": "always",
      "_tested": "pinned to the version published on 2026-10-26; not exercised with this template yet"
    },
    "http-client": {
      "command": "node",
      "args": ["${PROJECT_ROOT}/.claude/mcp-servers/http-client/server.js"],
      "disabled": false,
      "_capability": "API",
      "_tested": "bundled with the template"
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"],
      "disabled": false,
      "_capability": "Browser",
      "_tested": "in the maintainer's npx cache on Windows 11 (2026-10); not re-run during the 2.1 validation"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0"],
      "disabled": false,
      "_capability": "Browser",
      "_tested": "in the maintainer's npx cache on Windows 11 (2026-10); not re-run during the 2.1 validation"
    },
    "mcp_server_mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "${QA_DB_HOST}",
        "MYSQL_PORT": "${QA_DB_PORT}",
        "MYSQL_USER": "${QA_DB_USER}",
        "MYSQL_PASS": "${QA_DB_PASS}",
        "MYSQL_DB": "${QA_DB_NAME}",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      },
      "disabled": false,
      "_capability": "DB",
      "_tested": "in the maintainer's npx cache on Windows 11 (2026-10); not re-run during the 2.1 validation",
      "_note": "Write flags ship false (read-only). /configure-project flips test-DB writes on only if PROJECT-PROFILE.md §6 allows. For Postgres/Mongo, /configure-project swaps this server and rebinds the DB tool id (.claude/tool-bindings.json)."
    },
    "mcp_server_mysql_prod": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql@2.0.9"],
      "env": {
        "MYSQL_HOST": "${PROD_DB_HOST}",
        "MYSQL_PORT": "${PROD_DB_PORT}",
        "MYSQL_USER": "${PROD_DB_USER}",
        "MYSQL_PASS": "${PROD_DB_PASS}",
        "MYSQL_DB": "${PROD_DB_NAME}",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      },
      "disabled": true,
      "_capability": "Prod-DB",
      "_tested": "same package and version as mcp_server_mysql",
      "_note": "Read-only always. Often needs an SSH tunnel on 127.0.0.1; bring the tunnel up before enabling."
    },
    "postman-api-mcp": {
      "command": "npx",
      "args": ["-y", "postman-mcp-server@1.2.0", "--full"],
      "env": { "POSTMAN_API_KEY": "${POSTMAN_API_KEY}" },
      "disabled": true,
      "_capability": "Postman",
      "_tested": "pinned to the version published on 2026-10-26; not exercised with this template yet"
    }
  }
}